# Copy to .env (never committed) and fill in; install.sh moves each value into /etc/* (mode 600).
# Required: Vultr Serverless Inference API key (all LLM calls).
VULTR_INFERENCE_KEY=
# Console port (public).
RESTORER_PORT=80

# Frappe target (optional; leave FRAPPE_SOURCE_URL empty to turn it off).
# Production is only read (Backups page, downloads, counts); the test site is the only one written,
# and a test URL on port 80 or equal to the source is refused at startup.
FRAPPE_SOURCE_URL=
FRAPPE_SOURCE_SITE=demo.local
FRAPPE_TEST_URL=
FRAPPE_TEST_SITE=test.local
# Frappe API tokens, "api_key:api_secret"; the source token needs read access only.
FRAPPE_SOURCE_TOKEN=
FRAPPE_TEST_TOKEN=

# Stand-in Nordvik app backups served over HTTP instead of the local folder (optional).
RESTOREGUARD_BACKUPS_URL=
BACKUPS_TOKEN=
ADMIN_PASSWORD=
