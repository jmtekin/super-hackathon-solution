# Copy to .env (never committed) and fill in; install.sh moves each value into /etc/* (mode 600).
# Required: Vultr Serverless Inference API key (all LLM calls).
VULTR_INFERENCE_KEY=
# Console port when PUBLIC_HOST is empty (served directly, plain HTTP).
RESTORER_PORT=80
# Public hostname for HTTPS via Caddy (automatic TLS), e.g. 203-0-113-7.sslip.io; the console then
# listens on 127.0.0.1 only. Every write (Run drill, Add .sql, rerun) needs WRITE_USER/WRITE_PASSWORD.
PUBLIC_HOST=
WRITE_USER=team
WRITE_PASSWORD=

# Frappe target (optional; leave FRAPPE_SOURCE_URL empty to turn it off).
# Production is only read (Backups page, downloads, counts); the test site is the only one written,
# and a test URL on port 80 or equal to the source is refused at startup.
FRAPPE_SOURCE_URL=
FRAPPE_SOURCE_SITE=demo.local
FRAPPE_TEST_URL=
FRAPPE_TEST_SITE=test.local
# Frappe API tokens, "api_key:api_secret"; the source token needs read access only.
FRAPPE_SOURCE_TOKEN=
FRAPPE_TEST_TOKEN=
# test.local is restored by `bench restore` over a forced-command SSH key (path to the private key on
# this VM), against the pinned host key line "<host> ssh-ed25519 AAAA..." (quoted). Login defaults to frappe.json.
FRAPPE_SSH_KEY_FILE=
FRAPPE_SSH_HOST_KEY=
FRAPPE_SSH_LOGIN=
# Second column (optional): test2.local on the second bench (demo_app 2.0.0), its own forced-command key
# (restore_test2_site.sh) on the same host; old backups there are healed by the GLM bridge.
FRAPPE_TEST2_URL=
FRAPPE_TEST2_SITE=test2.local
FRAPPE_TEST2_TOKEN=
FRAPPE_TEST2_SSH_KEY_FILE=

# Stand-in Nordvik app backups served over HTTP instead of the local folder (optional).
RESTOREGUARD_BACKUPS_URL=
BACKUPS_TOKEN=
ADMIN_PASSWORD=
